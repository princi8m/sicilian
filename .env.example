# Copy to .env and fill in. NEVER commit .env
DATABASE_URL="mysql://user:password@host:3306/festival_db"

# Used to sign the admin session cookie. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Seed admin credentials (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@berlinindiefilmfestival.com"
SEED_ADMIN_PASSWORD="changeme123"

